PORT=8080
# Local development listener. The container sets HOST=0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
INTAKE_DB_PATH=./data/intake.sqlite
# Provision actual random secrets in your deployment secret store, never in committed files.
PUBLIC_API_KEYS_JSON=[]
PUBLIC_API_PROVISIONING_TOKEN=replace-with-a-unique-random-provisioning-secret
# Optional separate durable path; otherwise WorkDay shares INTAKE_DB_PATH.
# WORKDAY_EXCHANGE_DB_PATH=./data/workday.sqlite
# Optional clamscan-compatible executable. Without it attachments remain quarantined.
MALWARE_SCANNER_PATH=
# Verified gallery identity provider integration is pending. No mock identities are accepted.

# Unified portal: two hostnames, one Node service.
PUBLIC_WEB_HOST=web.bryanstudiosltd.com
PUBLIC_API_HOST=api.bryanstudiosltd.com
PUBLIC_ALLOWED_HOSTS=web.bryanstudiosltd.com,api.bryanstudiosltd.com
PUBLIC_WEB_ORIGIN=https://web.bryanstudiosltd.com

# Real client identity providers (leave unset to disable a provider).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Personal Microsoft accounts by default; optionally one explicit organization tenant UUID.
MICROSOFT_TENANT_ID=consumers
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Production gallery storage: private S3 bucket, using the instance IAM role.
GALLERY_STORAGE_MODE=s3
AWS_REGION=
GALLERY_S3_BUCKET=
GALLERY_S3_PREFIX=bryans-galleries
# No client preview is delivered without a generated pixel-embedded watermark.
PUBLIC_WATERMARK_PROCESSING_ENABLED=true
GALLERY_WATERMARK_TEXT=BRYAN'S
GALLERY_WATERMARK_OPACITY=0.23
GALLERY_PREVIEW_MAX_WIDTH=1600
GALLERY_WATERMARK_VERSION=v1
