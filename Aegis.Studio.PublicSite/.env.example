PORT=8080
# Studio initiates WorkDay synchronization; there is no inbound Studio upstream.
NODE_ENV=development
PUBLIC_DEMO_MODE=false
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
INTAKE_DB_PATH=./data/intake.sqlite
# Provision actual random secrets in your deployment secret store, never in committed files.
PUBLIC_API_KEYS_JSON=[]
# Optional clamscan-compatible executable. Without it attachments remain quarantined.
MALWARE_SCANNER_PATH=
# Authenticated identity ID -> Studio client UUID. Demo identities are test-only.
CLIENT_BINDINGS_JSON={}

# WorkDay remote media: durable temporary storage, separate from website gallery copies.
# A real MALWARE_SCANNER_PATH must be configured; absent/failed scans quarantine files.
REMOTE_MEDIA_PATH=./data/remote-media
REMOTE_MEDIA_MAX_FILE_BYTES=100000000
REMOTE_MEDIA_USER_QUOTA_BYTES=10000000000
REMOTE_MEDIA_TOTAL_QUOTA_BYTES=100000000000
WORKDAY_AUTHORIZATION_MAX_AGE_HOURS=24
GALLERY_TRANSFER_QUOTA_BYTES=100000000000
# Independent reference website consumer. Credential scopes: gallery:request, gallery:transfer.
REFERENCE_GALLERY_API_URL=https://api.bryanstudiosltd.com/
REFERENCE_GALLERY_API_KEY=
REFERENCE_GALLERY_DB_PATH=./data/reference-gallery.sqlite
REFERENCE_GALLERY_MEDIA_PATH=./data/reference-gallery-media
