PORT=8080
NODE_ENV=development
PUBLIC_DEMO_MODE=false
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
INTAKE_DB_PATH=./data/intake.sqlite
# Provision actual random secrets in your deployment secret store, never in committed files.
PUBLIC_API_KEYS_JSON=[]
# Optional clamscan-compatible executable. Without it attachments remain quarantined.
MALWARE_SCANNER_PATH=
# Authenticated identity ID -> Studio client UUID. Demo identities are test-only.
CLIENT_BINDINGS_JSON={}
