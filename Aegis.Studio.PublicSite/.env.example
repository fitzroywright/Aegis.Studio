PORT=8080
# Local development listener. The container sets HOST=0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
INTAKE_DB_PATH=./data/intake.sqlite
# Provision actual random secrets in your deployment secret store, never in committed files.
PUBLIC_API_KEYS_JSON=[]
PUBLIC_API_PROVISIONING_TOKEN=replace-with-a-unique-random-provisioning-secret
# Optional separate durable path; otherwise WorkDay shares INTAKE_DB_PATH.
# WORKDAY_EXCHANGE_DB_PATH=./data/workday.sqlite
# Optional clamscan-compatible executable. Without it attachments remain quarantined.
MALWARE_SCANNER_PATH=
# Verified gallery identity provider integration is pending. No mock identities are accepted.
