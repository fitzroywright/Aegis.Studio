<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>Aegis.Studio.Web-Development</UserSecretsId>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Aegis.Studio.Application/Aegis.Studio.Application.csproj" />
    <ProjectReference Include="../Aegis.Studio.Domain/Aegis.Studio.Domain.csproj" />
    <ProjectReference Include="../Aegis.Studio.Infrastructure/Aegis.Studio.Infrastructure.csproj" />
    <ProjectReference Include="../Aegis.Pos.Core/Aegis.Pos.Core.csproj" />
    <ProjectReference Include="../Aegis.Pos.DeviceClient/Aegis.Pos.DeviceClient.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\Common.Security.Plugin.ActiveDirectory.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(CommonRoot)\Common.Secrets\Common.Secrets.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Messaging\Common.Messaging.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Diagnostics\Common.Diagnostics.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Storage\Common.Storage.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Registration\Common.Registration.csproj" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../configuration/Aegis.Studio.configuration-contract.json" Link="configuration/Aegis.Studio.configuration-contract.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StageAuthenticationPluginAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)plugins" />
    <ItemGroup>
      <AuthenticationPluginFiles Include="$(AuthenticationPluginOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AuthenticationPluginFiles)"
          DestinationFiles="@(AuthenticationPluginFiles->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)plugins\Common.Security.Plugin.ActiveDirectory.dll')"
           Text="Authentication plugin was not staged to $(OutDir)plugins." />
  </Target>

  <Target Name="StageAuthenticationPluginForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="$(AuthenticationPluginSource)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true" />
  </Target>
</Project>