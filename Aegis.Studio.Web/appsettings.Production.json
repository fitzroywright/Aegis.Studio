{
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "OpenBao"
    ],
    "WorkloadName": "Aegis.Studio",
    "EnvironmentName": "Production",
    "Providers": {
      "OpenBao": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "RequireHttps": true,
          "MountPath": "secret",
          "BasePath": "aegis",
          "AuthMountPath": "approle",
          "SecretIdEnvironmentVariable": "OPENBAO_SECRET_ID",
          "DeleteSecretIdFileAfterRead": true,
          "ClearSecretIdEnvironmentVariableAfterRead": true,
          "RenewTokens": true,
          "RevokeTokenOnDispose": true
        }
      }
    }
  },
  "Security": {
    "RequireHttps": true,
    "TrustForwardedProto": false,
    "RequireSameOriginWrites": true,
    "MaxRequestMegabytes": 8,
    "MaxMultipartMegabytes": 300
  },
  "Galleries": {
    "AllowPublicOriginalDownloads": false
  },
  "Storage": {
    "MaxGalleryImageMegabytes": 25,
    "Provider": "NetworkFolder",
    "NetworkFolder": {
      "RootPath": "\\\\\\\\nas01\\\\Studio"
    },
    "SharePoint": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "storage/sharepoint/client-secret",
      "HostName": "",
      "SitePath": "sites/Bryans",
      "DriveId": "",
      "DriveName": "Documents",
      "RootFolder": "Aegis/Studio"
    },
    "AzureBlob": {
      "ConnectionStringSecretName": "storage/azureblob/connection-string",
      "ContainerName": "aegis-studio",
      "RootFolder": "Aegis/Studio"
    },
    "AmazonS3": {
      "BucketName": "",
      "Region": "us-east-1",
      "AccessKeyId": "",
      "SecretAccessKeyName": "storage/amazons3/secret-access-key",
      "RootFolder": "Aegis/Studio",
      "ServiceUrl": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Npgsql": "Warning"
    }
  }
}
