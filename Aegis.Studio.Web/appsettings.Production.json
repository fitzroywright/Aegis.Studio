{
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "OpenBao"
    ],
    "WorkloadName": "Aegis.Studio",
    "EnvironmentName": "Production",
    "Providers": {
      "OpenBao": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "RequireHttps": true,
          "MountPath": "secret",
          "BasePath": "aegis",
          "AuthMountPath": "approle",
          "SecretIdEnvironmentVariable": "OPENBAO_SECRET_ID",
          "DeleteSecretIdFileAfterRead": true,
          "ClearSecretIdEnvironmentVariableAfterRead": true,
          "RenewTokens": true,
          "RevokeTokenOnDispose": true
        }
      }
    }
  },
  "Security": {
    "RequireHttps": true,
    "TrustForwardedProto": false,
    "RequireSameOriginWrites": true,
    "MaxRequestMegabytes": 8,
    "MaxMultipartMegabytes": 300
  },
  "Galleries": {
    "AllowPublicOriginalDownloads": false
  },
  "Storage": {
    "MaxGalleryImageMegabytes": 25,
    "Provider": "S3",
    "NetworkFolder": {
      "RootPath": "\\\\\\\\nas01\\\\Studio"
    },
    "SharePoint": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "storage/sharepoint/client-secret",
      "HostName": "",
      "SitePath": "sites/Bryans",
      "DriveId": "",
      "DriveName": "Documents",
      "RootFolder": "Aegis/Studio"
    },
    "AzureBlob": {
      "ConnectionStringSecretName": "storage/azureblob/connection-string",
      "ContainerName": "aegis-studio",
      "RootFolder": "Aegis/Studio"
    },
    "S3": {
      "Endpoint": "",
      "Region": "us-east-1",
      "Bucket": "",
      "AccessKeyIdSecretName": "storage/s3/access-key-id",
      "SecretAccessKeySecretName": "storage/s3/secret-access-key",
      "RootFolder": "Aegis/Studio",
      "ForcePathStyle": true,
      "RequireHttps": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Npgsql": "Warning"
    }
  },
  "Messaging": {
    "DeliveryPollSeconds": 30,
    "MicrosoftGraph": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "messaging/msgraph/client-secret",
      "Email": {
        "Enabled": false,
        "InboundEnabled": false,
        "InboundPollSeconds": 30,
        "InboundPageSize": 50,
        "SenderUpn": ""
      }
    },
    "WhatsApp": {
      "Enabled": false,
      "GraphApiVersion": "v23.0",
      "PhoneNumberId": "",
      "AccessTokenSecretName": "messaging/whatsapp/access-token"
    }
  },
  "BookingApi": {
    "RequiredDeposit": 0
  },
  "ClientGallery": {
    "Provider": "Manifest"
  }
}
