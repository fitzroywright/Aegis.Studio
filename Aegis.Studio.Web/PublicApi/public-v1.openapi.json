  "components": {
    "securitySchemes": {
      "IntegrationSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Studio-Signature",
        "description": "HMAC-SHA256 plus client, timestamp and fresh nonce headers; signature binds method, path/query, timestamp, nonce, SHA256 body and Idempotency-Key."
      },
      "GalleryToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Customer access issued from the Studio Job; grants only that Job gallery."
      }
    },
    "schemas": {
      "BookingRequest": {
        "type": "object",
        "required": [
          "clientName",
          "clientEmail",
          "sessionType",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "clientName": {
            "type": "string"
          },
          "clientEmail": {
            "type": "string"
          },
          "sessionType": {
            "type": "string"
          },
          "clientPhone": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BookingReceipt": {
        "type": "object",
        "required": [
          "reference",
          "status",
          "requiredDeposit",
          "currency"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "confirmed",
              "ready",
              "delivered",
              "completed",
              "cancelled"
            ]
          },
          "requiredDeposit": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "JMD"
            ]
          }
        }
      },
      "GalleryItem": {
        "type": "object",
        "required": [
          "versionId",
          "fileName",
          "selected"
        ],
        "properties": {
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          }
        }
      },
      "GalleryPage": {
        "type": "object",
        "required": [
          "reference",
          "publicationId",
          "title",
          "finalDeliveryAvailable",
          "items",
          "nextCursor"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "format": "uuid"
          },
          "publicationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "finalDeliveryAvailable": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GalleryItem"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "SelectionRequest": {
        "type": "object",
        "required": [
          "selected"
        ],
        "properties": {
          "selected": {
            "type": "boolean"
          }
        }
      },
      "SelectionReceipt": {
        "type": "object",
        "required": [
          "versionId",
          "selected"
        ],
        "properties": {
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "selected": {
            "type": "boolean"
          }
        }
      },
      "SelectionSubmission": {
        "type": "object",
        "required": [
          "reference",
          "publicationId",
          "versionIds",
          "submittedAt"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "format": "uuid"
          },
          "publicationId": {
            "type": "string",
            "format": "uuid"
          },
          "versionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
