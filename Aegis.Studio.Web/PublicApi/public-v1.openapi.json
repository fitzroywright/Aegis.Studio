  "openapi": "3.1.0",
  "info": {
    "title": "Brian\u2019s Studio Public API",
    "version": "1.0.0",
    "description": "Backward compatible V1 contract. HTTPS only. Gallery access is an expiring/revocable customer capability. Final downloads always enforce approval and financial release on the server."
  },
  "servers": [
    {
      "url": "https://studio.example/api/public/v1",
      "description": "Replace host with this Studio installation"
    }
  ],
