{
  "Aegis": {
    "Configuration": {
      "Url": "https://config.ffpja.org"
    },
    "Diagnostics": {
      "Url": "https://diagnostics.ffpja.org",
      "RequestCredentialSecretName": "diagnostics/machine/Aegis.Studio",
      "StorePath": "data/diagnostic-level/studio.db"
    },
    "Operations": {
      "Url": "https://operations.ffpja.org"
    }
  },
  "MicrosoftGraphEmail": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "Mailbox": "",
    "PollSeconds": 30,
    "PageSize": 50
  },
  "Messaging": {
    "MicrosoftGraph": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "messaging/msgraph/client-secret",
      "Email": {
        "Enabled": false,
        "SenderUpn": ""
      },
      "Teams": {
        "Enabled": false,
        "SenderUpn": "",
        "DelegatedAccessTokenSecretName": "messaging/msgraph/teams/delegated-access-token"
      }
    },
    "AllowedPersonalSenderDomains": []
  },
  "Notifications": {
    "SlackWebhookUrl": "",
    "TeamsWebhookUrl": ""
  },
  "Storage": {
    "Provider": "NetworkFolder",
    "Local": {
      "RootPath": "./Storage"
    },
    "NetworkFolder": {
      "RootPath": "\\\\\\\\nas01\\\\Studio"
    },
    "SharePoint": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "storage/sharepoint/client-secret",
      "HostName": "",
      "SitePath": "sites/Bryans",
      "DriveId": "",
      "DriveName": "Documents",
      "RootFolder": "Aegis/Studio"
    },
    "AttachmentsPath": "",
    "MediaArchivePath": "",
    "MaxAttachmentMegabytes": 100,
    "AzureBlob": {
      "ConnectionStringSecretName": "storage/azureblob/connection-string",
      "ContainerName": "aegis-studio",
      "RootFolder": "Aegis/Studio"
    },
    "S3": {
      "Endpoint": "",
      "Region": "us-east-1",
      "Bucket": "",
      "AccessKeyIdSecretName": "storage/s3/access-key-id",
      "SecretAccessKeySecretName": "storage/s3/secret-access-key",
      "RootFolder": "Aegis/Studio",
      "ForcePathStyle": true,
      "RequireHttps": true
    }
  },
  "WorkDay": {
    "LocationTrackingEnabled": false,
    "LocationTrackingMode": "SignInOutOnly",
    "DeviceSessionDays": 30,
    "TelemetryStaleSeconds": 300,
    "LocationRetentionDays": 30,
    "TimeTracking": {
      "TimeZoneId": "America/Jamaica",
      "RegularDailyHours": 8,
      "WeekendDays": [
        "Saturday",
        "Sunday"
      ]
    }
  },
  "Scheduling": {
    "DefaultDailyCapacityHours": 8
  },
  "Performance": {
    "PhotographerOnTimeGraceMinutes": 15
  },
  "AuthenticationPlugin": {
    "Enabled": true,
    "AssemblyPath": "plugins/Common.Security.Plugin.ActiveDirectory.dll",
    "Settings": {
      "Domain": "",
      "SearchBase": "",
      "Port": 636,
      "TimeoutSeconds": 5,
      "Servers": [],
      "AdministrativeGroups": []
    }
  },
  "Studio": {
    "Workflow": {
      "Stages": [
        "Needs scheduling",
        "Scheduled",
        "Photography",
        "Production",
        "Ready for Client",
        "Completed"
      ]
    }
  },
  "BookingApi": {
    "RequiredDeposit": 0
  },
  "ClientGallery": {
    "Provider": ""
  }
}
