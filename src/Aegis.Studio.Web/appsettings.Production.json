{
  "Security": {
    "RequireHttps": true,
    "TrustForwardedProto": false,
    "MaxRequestMegabytes": 8,
    "MaxMultipartMegabytes": 300
  },
  "Galleries": {
    "AllowPublicOriginalDownloads": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Npgsql": "Warning"
    }
  }
}
