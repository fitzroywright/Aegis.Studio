{
  "applicationId": "Aegis.Studio",
  "displayName": "Aegis Studio",
  "version": "1.0.0",
  "description": "Studio workspace, booking, messaging, gallery and production application.",
  "requirements": [
    {
      "id": "public-url",
      "displayName": "Public Service URL",
      "kind": "Configuration",
      "required": true,
      "purpose": "Canonical externally reachable Studio URL used by Control Plane health monitoring.",
      "configurationKey": "Aegis:PublicUrl",
      "isConfigured": false
    },
    {
      "id": "database",
      "displayName": "Studio PostgreSQL database",
      "kind": "Secret",
      "required": true,
      "purpose": "Stores Studio application data and durable messaging state.",
      "secretName": "ConnectionStrings:Studio",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "graph-tenant",
      "displayName": "Microsoft Graph tenant ID",
      "kind": "Configuration",
      "required": true,
      "purpose": "Identifies the Microsoft 365 tenant used by the Studio mail router.",
      "configurationKey": "MicrosoftGraphEmail:TenantId",
      "isConfigured": false
    },
    {
      "id": "graph-client",
      "displayName": "Microsoft Graph application client ID",
      "kind": "Configuration",
      "required": true,
      "purpose": "Identifies the application registration used by the Studio mail router.",
      "configurationKey": "MicrosoftGraphEmail:ClientId",
      "isConfigured": false
    },
    {
      "id": "graph-client-secret",
      "displayName": "Microsoft Graph application credential",
      "kind": "Secret",
      "required": true,
      "purpose": "Authenticates the Studio mail router to Microsoft Graph through Common.Secrets.",
      "secretName": "Studio:MicrosoftGraphEmail:ClientSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "graph-mailbox",
      "displayName": "Studio mail-router mailbox",
      "kind": "Configuration",
      "required": true,
      "purpose": "Selects the mailbox monitored by the Studio mail router.",
      "configurationKey": "MicrosoftGraphEmail:Mailbox",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-tenant",
      "displayName": "Messaging Microsoft Graph tenant ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Microsoft 365 tenant used by Common.Messaging Graph channels.",
      "configurationKey": "Messaging:MicrosoftGraph:TenantId",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-client",
      "displayName": "Messaging Microsoft Graph client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Entra application used by Common.Messaging Graph email.",
      "configurationKey": "Messaging:MicrosoftGraph:ClientId",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-client-secret",
      "displayName": "Messaging Microsoft Graph client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Authenticates Common.Messaging Graph email without exposing provider-specific secret access to Studio.",
      "secretName": "messaging/msgraph/client-secret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "messaging-graph-email-enabled",
      "displayName": "Microsoft Graph Email channel",
      "kind": "Configuration",
      "required": false,
      "purpose": "Enables Common.Messaging Microsoft Graph email delivery for Studio notifications.",
      "configurationKey": "Messaging:MicrosoftGraph:Email:Enabled",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-email-sender",
      "displayName": "Microsoft Graph Email sender",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the sender mailbox used for Common.Messaging Graph email notifications.",
      "configurationKey": "Messaging:MicrosoftGraph:Email:SenderUpn",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-teams-enabled",
      "displayName": "Microsoft Graph Teams channel",
      "kind": "Configuration",
      "required": false,
      "purpose": "Enables Common.Messaging delegated Microsoft Teams direct-message delivery.",
      "configurationKey": "Messaging:MicrosoftGraph:Teams:Enabled",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-teams-sender",
      "displayName": "Microsoft Graph Teams sender",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the delegated service user used for Teams direct messages.",
      "configurationKey": "Messaging:MicrosoftGraph:Teams:SenderUpn",
      "isConfigured": false
    },
    {
      "id": "messaging-graph-teams-token",
      "displayName": "Microsoft Graph Teams delegated token",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the delegated Teams token to Common.Messaging through Common.Secrets.",
      "secretName": "messaging/msgraph/teams/delegated-access-token",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "storage-provider",
      "displayName": "Application storage provider",
      "kind": "Configuration",
      "required": true,
      "purpose": "Selects the Common.Storage target used for Studio attachments, messages, galleries, and media versions.",
      "configurationKey": "Storage:Provider",
      "isConfigured": false,
      "example": "LocalFolder | NetworkFolder | SharePoint"
    },
    {
      "id": "storage-local-root",
      "displayName": "Local storage root",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the local Common.Storage root when Storage:Provider is LocalFolder.",
      "configurationKey": "Storage:Local:RootPath",
      "isConfigured": false
    },
    {
      "id": "storage-network-root",
      "displayName": "Network folder storage root",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the UNC or mounted SMB/NFS Common.Storage root when Storage:Provider is NetworkFolder.",
      "configurationKey": "Storage:NetworkFolder:RootPath",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-tenant",
      "displayName": "SharePoint tenant ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Microsoft 365 tenant when Common.Storage uses SharePoint.",
      "configurationKey": "Storage:SharePoint:TenantId",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-client",
      "displayName": "SharePoint application client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Entra application used by Common.Storage SharePoint storage.",
      "configurationKey": "Storage:SharePoint:ClientId",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-host",
      "displayName": "SharePoint host",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the SharePoint Online host containing the configured storage site.",
      "configurationKey": "Storage:SharePoint:HostName",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-site",
      "displayName": "SharePoint site path",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the SharePoint site used by Common.Storage. Empty selects the host root site.",
      "configurationKey": "Storage:SharePoint:SitePath",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-drive",
      "displayName": "SharePoint document library",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the SharePoint drive/document library by DriveId or DriveName.",
      "configurationKey": "Storage:SharePoint:DriveName",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-root",
      "displayName": "SharePoint storage root folder",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the folder below the selected SharePoint document library reserved for Studio.",
      "configurationKey": "Storage:SharePoint:RootFolder",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-client-secret",
      "displayName": "SharePoint storage client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Authenticates Common.Storage to Microsoft Graph when SharePoint is the selected provider.",
      "secretName": "storage/sharepoint/client-secret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "media-archive",
      "displayName": "Media archive storage",
      "kind": "Configuration",
      "required": true,
      "purpose": "Defines persistent archive storage for Studio media.",
      "configurationKey": "Storage:MediaArchivePath",
      "isConfigured": false
    },
    {
      "id": "site-id",
      "displayName": "Site ID",
      "kind": "Configuration",
      "required": true,
      "purpose": "Identifies the deployment site for this Studio instance.",
      "configurationKey": "Site:Id",
      "isConfigured": false
    },
    {
      "id": "service-identity",
      "displayName": "Service identity",
      "kind": "Configuration",
      "required": true,
      "purpose": "Uniquely identifies this independently deployed Studio instance.",
      "configurationKey": "Service:Identity",
      "isConfigured": false,
      "workDayNote": "Also used by Aegis Studio WorkDay telemetry correlation."
    },
    {
      "id": "workday-location-enabled",
      "displayName": "WorkDay GPS tracking enabled",
      "kind": "Configuration",
      "required": false,
      "purpose": "Master enable/disable gate for all WorkDay GPS capture, upload and management location display.",
      "configurationKey": "WorkDay:LocationTrackingEnabled",
      "isConfigured": false,
      "example": "false"
    },
    {
      "id": "workday-location-mode",
      "displayName": "WorkDay location tracking mode",
      "kind": "Configuration",
      "required": false,
      "purpose": "Controls policy-driven field presence collection: Disabled, SignInOutOnly, AssignmentEvents or BackgroundDuringWork.",
      "configurationKey": "WorkDay:LocationTrackingMode",
      "isConfigured": false,
      "example": "SignInOutOnly"
    },
    {
      "id": "workday-device-session-days",
      "displayName": "WorkDay device session lifetime",
      "kind": "Configuration",
      "required": false,
      "purpose": "Controls the maximum lifetime of a revocable WorkDay mobile device session without storing user passwords.",
      "configurationKey": "WorkDay:DeviceSessionDays",
      "isConfigured": false,
      "example": "30"
    },
    {
      "id": "workday-telemetry-stale",
      "displayName": "WorkDay telemetry stale threshold",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines how long Operations may treat a WorkDay client observation as current before it becomes stale/offline.",
      "configurationKey": "WorkDay:TelemetryStaleSeconds",
      "isConfigured": false,
      "example": "300"
    },
    {
      "id": "workday-location-retention",
      "displayName": "WorkDay precise location retention",
      "kind": "Configuration",
      "required": false,
      "purpose": "Controls retention of acknowledged precise WorkDay location observations independently from longer-lived attendance/work-session records.",
      "configurationKey": "WorkDay:LocationRetentionDays",
      "isConfigured": false,
      "example": "30"
    },
    {
      "id": "scheduling-daily-capacity-hours",
      "displayName": "Scheduling daily staff capacity",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines nominal daily photographer capacity used by workspace managers for assignment and overload visibility.",
      "configurationKey": "Scheduling:DefaultDailyCapacityHours",
      "isConfigured": false,
      "example": "8"
    },
    {
      "id": "workday-time-zone",
      "displayName": "WorkDay time tracking timezone",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the local timezone used when classifying work sessions by local day for regular, overtime and weekend tracking.",
      "configurationKey": "WorkDay:TimeTracking:TimeZoneId",
      "isConfigured": false,
      "example": "America/Jamaica"
    },
    {
      "id": "workday-regular-daily-hours",
      "displayName": "WorkDay regular daily hours",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the daily regular-time threshold. Minutes beyond this threshold are classified as overtime evidence; this does not calculate pay rates.",
      "configurationKey": "WorkDay:TimeTracking:RegularDailyHours",
      "isConfigured": false,
      "example": "8"
    },
    {
      "id": "workday-weekend-days",
      "displayName": "WorkDay weekend days",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines which local weekdays are tracked as weekend work.",
      "configurationKey": "WorkDay:TimeTracking:WeekendDays",
      "isConfigured": false,
      "example": "Saturday,Sunday"
    },
    {
      "id": "performance-photographer-on-time-grace",
      "displayName": "Photographer on-time grace",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the grace period after scheduled call time used by descriptive photographer punctuality metrics.",
      "configurationKey": "Performance:PhotographerOnTimeGraceMinutes",
      "isConfigured": false,
      "example": "15"
    }
  ],
  "runbookReference": "docs/RUNBOOK.md",
  "workDayRunbookReference": "docs/WORKDAY-RUNBOOK.md",
  "diagnostics": {
    "baseUrl": null,
    "healthPath": "/health",
    "diagnosticsRunPath": "/api/engineering/diagnostics/diagnostic-level/run",
    "diagnosticsRunsPath": "/api/engineering/diagnostics/diagnostic-level/runs",
    "supportsRemoteDiagnostics": true,
    "supportsOperationalTelemetry": true,
    "authenticationScheme": "DiagnosticLevel-HMAC-SHA256",
    "secretName": "diagnostics/machine/Aegis.Studio",
    "supportedLevels": [
      5,
      4,
      3,
      2,
      1
    ]
  },
  "module": "Aegis.Studio.Web"
}
