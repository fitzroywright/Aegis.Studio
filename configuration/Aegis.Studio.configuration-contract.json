{
  "applicationId": "Aegis.Studio",
  "displayName": "Aegis Studio",
  "version": "1.0.0",
  "description": "Studio workspace, booking, messaging, gallery and production application.",
  "requirements": [
    { "id": "database", "displayName": "Studio PostgreSQL database", "kind": "Secret", "required": true, "purpose": "Stores Studio application data and durable messaging state.", "secretName": "ConnectionStrings:Studio", "isConfigured": false, "sensitive": true },
    { "id": "graph-tenant", "displayName": "Microsoft Graph tenant ID", "kind": "Configuration", "required": true, "purpose": "Identifies the Microsoft 365 tenant used by the Studio mail router.", "configurationKey": "MicrosoftGraphEmail:TenantId", "isConfigured": false },
    { "id": "graph-client", "displayName": "Microsoft Graph application client ID", "kind": "Configuration", "required": true, "purpose": "Identifies the application registration used by the Studio mail router.", "configurationKey": "MicrosoftGraphEmail:ClientId", "isConfigured": false },
    { "id": "graph-client-secret", "displayName": "Microsoft Graph application credential", "kind": "Secret", "required": true, "purpose": "Authenticates the Studio mail router to Microsoft Graph through Common.Secrets.", "secretName": "Studio:MicrosoftGraphEmail:ClientSecret", "isConfigured": false, "sensitive": true },
    { "id": "graph-mailbox", "displayName": "Studio mail-router mailbox", "kind": "Configuration", "required": true, "purpose": "Selects the mailbox monitored by the Studio mail router.", "configurationKey": "MicrosoftGraphEmail:Mailbox", "isConfigured": false },
    { "id": "messaging-graph-tenant", "displayName": "Messaging Microsoft Graph tenant ID", "kind": "Configuration", "required": false, "purpose": "Identifies the Microsoft 365 tenant used by Common.Messaging Graph channels.", "configurationKey": "Messaging:MicrosoftGraph:TenantId", "isConfigured": false },
    { "id": "messaging-graph-client", "displayName": "Messaging Microsoft Graph client ID", "kind": "Configuration", "required": false, "purpose": "Identifies the Entra application used by Common.Messaging Graph email.", "configurationKey": "Messaging:MicrosoftGraph:ClientId", "isConfigured": false },
    { "id": "messaging-graph-client-secret", "displayName": "Messaging Microsoft Graph client secret", "kind": "Secret", "required": false, "purpose": "Authenticates Common.Messaging Graph email without exposing provider-specific secret access to Studio.", "secretName": "messaging/msgraph/client-secret", "isConfigured": false, "sensitive": true },
    { "id": "messaging-graph-email-enabled", "displayName": "Microsoft Graph Email channel", "kind": "Configuration", "required": false, "purpose": "Enables Common.Messaging Microsoft Graph email delivery for Studio notifications.", "configurationKey": "Messaging:MicrosoftGraph:Email:Enabled", "isConfigured": false },
    { "id": "messaging-graph-email-sender", "displayName": "Microsoft Graph Email sender", "kind": "Configuration", "required": false, "purpose": "Selects the sender mailbox used for Common.Messaging Graph email notifications.", "configurationKey": "Messaging:MicrosoftGraph:Email:SenderUpn", "isConfigured": false },
    { "id": "messaging-graph-teams-enabled", "displayName": "Microsoft Graph Teams channel", "kind": "Configuration", "required": false, "purpose": "Enables Common.Messaging delegated Microsoft Teams direct-message delivery.", "configurationKey": "Messaging:MicrosoftGraph:Teams:Enabled", "isConfigured": false },
    { "id": "messaging-graph-teams-sender", "displayName": "Microsoft Graph Teams sender", "kind": "Configuration", "required": false, "purpose": "Identifies the delegated service user used for Teams direct messages.", "configurationKey": "Messaging:MicrosoftGraph:Teams:SenderUpn", "isConfigured": false },
    { "id": "messaging-graph-teams-token", "displayName": "Microsoft Graph Teams delegated token", "kind": "Secret", "required": false, "purpose": "Provides the delegated Teams token to Common.Messaging through Common.Secrets.", "secretName": "messaging/msgraph/teams/delegated-access-token", "isConfigured": false, "sensitive": true },
    { "id": "attachments-storage", "displayName": "Attachments storage", "kind": "Configuration", "required": true, "purpose": "Defines persistent storage for Studio message and job attachments.", "configurationKey": "Storage:AttachmentsPath", "isConfigured": false },
    { "id": "gallery-storage", "displayName": "Gallery storage", "kind": "Configuration", "required": true, "purpose": "Defines persistent storage for Studio galleries.", "configurationKey": "Storage:GalleriesPath", "isConfigured": false },
    { "id": "media-archive", "displayName": "Media archive storage", "kind": "Configuration", "required": true, "purpose": "Defines persistent archive storage for Studio media.", "configurationKey": "Storage:MediaArchivePath", "isConfigured": false },
    { "id": "site-id", "displayName": "Site ID", "kind": "Configuration", "required": true, "purpose": "Identifies the deployment site for this Studio instance.", "configurationKey": "Site:Id", "isConfigured": false },
    { "id": "service-identity", "displayName": "Service identity", "kind": "Configuration", "required": true, "purpose": "Uniquely identifies this independently deployed Studio instance.", "configurationKey": "Service:Identity", "isConfigured": false }
  ]
}
